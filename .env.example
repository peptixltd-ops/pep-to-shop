# Transactional email. log keeps messages in the outbox.
EMAIL_FROM=info@pondokpeptides.com
EMAIL_FROM_NAME=Pondok Peptides
EMAIL_TRANSPORT=log
SMTP_URL=

# Payment providers. Leave blank until sandbox keys exist.
