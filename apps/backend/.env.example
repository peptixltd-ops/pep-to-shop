STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:9000,http://localhost:3000
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-a-different-long-random-string
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa
EMAIL_OUTBOX=./data/email-outbox.jsonl
EMAIL_FROM=info@pondokpeptides.com
EMAIL_FROM_NAME=Pondok Peptides
# log writes the outbox only. smtp sends a single message when allow_send is set.
EMAIL_TRANSPORT=log
SMTP_URL=
MEDUSA_ADMIN_EMAIL=dev-admin@pondokpeptides.local
MEDUSA_ADMIN_PASSWORD=replace-me
# Set true on a small VPS if the admin dashboard build is not needed.
MEDUSA_DISABLE_ADMIN=false

# Shopify Admin is read-only. Do not commit a token.
# Scopes: read_products, read_inventory, read_customers, read_orders, read_all_orders, read_discounts, read_shipping
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STORE_DOMAIN=cqdyni-4v.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2025-10
# Shared store filter. Defaults match Pondok Peptides.
SHOPIFY_VENDOR=Pondok Peptides
SHOPIFY_SALES_CHANNEL_ID=
SHOPIFY_SALES_CHANNEL_NAME=

# Pay by bank. Leave blank until Wallid issues sandbox keys.
WALLID_API_KEY=
WALLID_API_BASE=
WALLID_WEBHOOK_SECRET=
WALLID_MERCHANT_ID=

# Card payments. Leave blank until NiftiPay issues sandbox keys.
NIFTIPAY_API_KEY=
NIFTIPAY_API_BASE=
NIFTIPAY_WEBHOOK_SECRET=
NIFTIPAY_MERCHANT_ID=
